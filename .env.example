# Copiar este archivo como .env (sin el .example) y completar las claves reales. El .env NO se sube a Git.

# Entrega 1 (extracción con Gemini y, como alternativa, con Claude)
GEMINI_API_KEY=...
GEMINI_MODEL_NAME=gemini-flash-lite-latest
ANTHROPIC_API_KEY=...
ANTHROPIC_MODEL_NAME=claude-haiku-4-5

# Entregas 2, 3 y TP Final: embeddings (text-embedding-3-small) y LLM (gpt-4o-mini). OBLIGATORIA para el agente
OPENAI_API_KEY=...

# Trazas en LangSmith (Entrega 3 B.4 y TP Final). Opcional: sin clave, poner LANGSMITH_TRACING=false
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=...
LANGSMITH_PROJECT=smart-flight-assistant-entrega3

# TP Final: la configuración que NO es secreta (modelo, límites, puerto, rutas) está en config.toml.
# Opcionales, solo para pisar config.toml sin editarlo:
# DATA_DIR=data/runtime                # memoria del agente (memoria.db), reservas (reservas.db) y logs (api.log)
# TIMEOUT_CONSULTA_SEGUNDOS=90         # tiempo máximo que la API espera al agente
